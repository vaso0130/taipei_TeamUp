{
  "name": "taipei-teamup",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "seed": "pnpm --filter @teamup/api seed",
    "e2e": "pnpm --filter @teamup/api build && playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
