# ============================================================
# 環境變數範例 — 所有值請留空或填假值，絕不 commit 真實密鑰
# 本機開發：複製為 .env.local（已在 .gitignore 內）再填值
# 正式環境：一律走 Secret Manager，不用 .env 檔
# ============================================================

# ---- API (apps/api) ----
# Cloud Run 會注入 PORT；本機預設 8080
PORT=8080

# PostgreSQL 連線字串。留空時 API 以「seed 檔記憶體模式」啟動（唯讀，
# 供本機快速預覽與測試，不需要資料庫）。
# 本機 docker-compose 範例：postgres://teamup:localdev@localhost:5432/teamup
DATABASE_URL=

# 活動 seed 檔目錄（選填，預設 apps/api/seeds/events）
EVENT_SEED_DIR=

# ---- 驗證與加密（DATABASE_URL 有設定時必填）----
# firebase = 驗 Firebase ID token（需 FIREBASE_PROJECT_ID）
# dev      = 本機開發用，接受 "dev:<email>" 假 token（production 會拒絕啟動）
AUTH_PROVIDER=dev
FIREBASE_PROJECT_ID=
# 欄位加密 KEK 提供者：local（本機）；Cloud KMS 版本於部署階段加入
KEK_PROVIDER=local
# 本機 KEK：32 bytes 的 base64。產生方式：
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
LOCAL_KEK_BASE64=
# Email HMAC pepper（至少 32 字元，正式環境放 Secret Manager，絕不進 DB 與 repo）
EMAIL_HMAC_PEPPER=
# pepper 輪替期間的舊 pepper（選填，ADR-028）：登入時新 pepper 查不到就試舊值，
# 命中即改寫成新 pepper；輪替完成（或跑過 rehash:email-lookups）後移除
EMAIL_HMAC_PEPPER_PREVIOUS=
# PostgreSQL 連線池上限（選填，預設 10；Cloud Run 每實例一個 pool，
# 總連線數 = 實例數 × 此值，須小於 Cloud SQL 的 max_connections）
DB_POOL_MAX=

# ---- GCP（部署用，本機開發不需要）----
GCP_PROJECT_ID=
GCP_REGION=asia-east1
# Cloud KMS KEK 完整資源路徑（欄位加密用）
KMS_KEY_NAME=
# Secret Manager 上存放 email HMAC pepper 的資源名稱（不是 pepper 本身！）
EMAIL_HMAC_PEPPER_SECRET=
# ---- 內容審核（M5）----
# mock   = 本機開發，一律低風險放行，不呼叫外部 API（production 拒絕啟動）
# vertex = Vertex AI Gemini（需 GCP_PROJECT_ID 與 ADC 憑證）
MODERATION_PROVIDER=mock
# 審核用 Gemini 模型 ID（做成設定值：gemini-2.5-flash 已於 2026-10 退役，
# 見 DECISIONS.md ADR-005）
MODERATION_MODEL=gemini-3.5-flash
# Vertex 端點位置：Gemini 3.x 只在 global 端點提供（區域端點會 404）
MODERATION_LOCATION=global
# in-process = 同進程處理（本機）；cloud-tasks = Cloud Tasks（正式環境；
# NODE_ENV=production 下設 in-process 會拒絕啟動，ADR-031）
MODERATION_QUEUE=in-process
# cloud-tasks 模式必填：
CLOUD_TASKS_QUEUE_PATH=
MODERATION_TASK_TARGET_URL=
INTERNAL_TASK_SECRET=
# 待審內容超過幾分鐘仍無審核紀錄，就由每日 cleanup 重新入列（選填，預設 15；ADR-025）
MODERATION_REQUEUE_AFTER_MINUTES=
# 管理員（人工審核後台）email 名單，逗號分隔
ADMIN_EMAILS=

# 允許跨源呼叫 API 的前端來源（逗號分隔）；留空 = 不送 CORS 標頭（同源部署/本機 proxy）
ALLOWED_ORIGINS=

# ---- 濫用防護（M6）----
# reCAPTCHA Enterprise site key；留空 = 停用（本機開發）
RECAPTCHA_SITE_KEY=
# 帳號層限流（皆選填，正整數；留空用預設值。這些是平台規則不是活動規則，見 ADR-031）
#   TEAM_CREATES_PER_DAY 3（開團）、MESSAGES_PER_HOUR 30（站內訊息）、REPORTS_PER_HOUR 10（檢舉）、
#   NAME_CHANGES_PER_HOUR 10（暱稱／隊名變更，每次都是一次行內模型審查）、
#   PARTICIPATION_WRITES_PER_HOUR 20（參加資料寫入）、INVITATIONS_PER_DAY 20（邀請）、
#   APPLIES_PER_DAY 20（申請）、EXPORTS_PER_DAY 3（個資匯出，每次全欄位經 KMS 解密）
RATE_LIMIT_TEAM_CREATES_PER_DAY=
RATE_LIMIT_MESSAGES_PER_HOUR=
RATE_LIMIT_REPORTS_PER_HOUR=
RATE_LIMIT_NAME_CHANGES_PER_HOUR=
RATE_LIMIT_PARTICIPATION_WRITES_PER_HOUR=
RATE_LIMIT_INVITATIONS_PER_DAY=
RATE_LIMIT_APPLIES_PER_DAY=
RATE_LIMIT_EXPORTS_PER_DAY=

# ---- Web (apps/web) ----
# 要顯示的活動 slug；留空時前端會抓取活動列表並顯示第一個開放中的活動
VITE_EVENT_SLUG=
# API base URL；留空時走同源（本機 dev 由 Vite proxy 轉發 /api）
VITE_API_BASE_URL=
# Firebase Web 設定（三者齊備才啟用 Google / Email link 登入；缺任一 → dev 登入）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# reCAPTCHA Enterprise site key（前端；留空 = 停用）
VITE_RECAPTCHA_SITE_KEY=
# 登入信寄件者（顯示在「請檢查垃圾郵件」提示）；留空 = noreply@<VITE_FIREBASE_AUTH_DOMAIN>
# 例：noreply@xn--ej4a.taipei（punycode 網域會自動並列顯示為 noreply@配.taipei）
VITE_MAIL_SENDER=
# 寄件者的易讀寫法；留空 = 自動把 xn-- 標籤解碼為 Unicode
VITE_MAIL_SENDER_DISPLAY=
